---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts, url } from '../../lib/posts';
export async function getStaticPaths() { const posts=await allPosts(); return [...new Set(posts.flatMap(p=>p.data.tags))].map(tag => ({params:{tag},props:{tag,posts:posts.filter(p=>p.data.tags.includes(tag))}})); }
const { tag, posts }=Astro.props;
---
<Base title={`标签：${tag}`}><section class="page-heading"><a class="back-link" href={url('topics/')}>← 所有标签</a><h1>#{tag}<span class="accent">。</span></h1><p>带有这个标签的 {posts.length} 篇记录。</p></section>{posts.map((post,index)=><PostCard post={post} index={index}/>)}</Base>
