---
import Base from '../../layouts/Base.astro';
import PostCard from '../../components/PostCard.astro';
import { allPosts, url } from '../../lib/posts';
export async function getStaticPaths() { const posts=await allPosts(); return [...new Set(posts.flatMap(p=>p.data.topics))].map(topic => ({params:{topic},props:{topic,posts:posts.filter(p=>p.data.topics.includes(topic))}})); }
const { topic, posts }=Astro.props;
---
<Base title={topic}><section class="page-heading"><a class="back-link" href={url('topics/')}>← 所有主题</a><h1>{topic}<span class="accent">。</span></h1><p>这个主题下的 {posts.length} 篇记录。</p></section>{posts.map((post,index)=><PostCard post={post} index={index}/>)}</Base>
