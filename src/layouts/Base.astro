---
import { siteConfig } from '../../site.config.mjs';
import { url } from '../lib/posts';
import '../styles/global.css';
import 'katex/dist/katex.min.css';
interface Props { title?: string; description?: string; }
const { title, description = siteConfig.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
const nav = [{path:'',label:'首页'}, {path:'archive/',label:'归档'}, {path:'topics/',label:'主题'}, {path:'graph/',label:'关系图'}, {path:'about/',label:'关于'}];
---
<!doctype html>
<html lang={siteConfig.language}>
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="description" content={description} /><meta name="color-scheme" content="light dark" />
  <title>{title ? `${title} · ${siteConfig.title}` : siteConfig.title}</title>
  <link rel="canonical" href={canonical} /><link rel="icon" type="image/svg+xml" href={url('favicon.svg')} />
  <meta property="og:title" content={title ?? siteConfig.title} /><meta property="og:description" content={description} />
  <meta property="og:type" content="website" /><meta property="og:url" content={canonical} />
  <script is:inline>
    try { const theme = localStorage.getItem('theme'); if (theme === 'dark' || theme === 'light') document.documentElement.dataset.theme = theme; } catch {}
  </script>
</head>
<body>
<a class="skip" href="#main">跳到正文</a>
<header class="site-header">
  <a class="brand" href={url()}><span class="brand-mark" aria-hidden="true">t<span>.</span></span><span>{siteConfig.title}<small>READING & THINKING</small></span></a>
  <nav aria-label="主导航">{nav.map(item => <a href={url(item.path)} aria-current={Astro.url.pathname === url(item.path) ? 'page' : undefined}>{item.label}</a>)}<a class="search-nav" href={url('search/')} aria-label="站内搜索"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="10.5" cy="10.5" r="6.5"/><path d="m16 16 5 5"/></svg><span>搜索</span></a><button id="theme-toggle" class="theme-toggle" aria-label="切换明暗主题" title="切换明暗主题">◐</button></nav>
</header>
<main id="main"><slot /></main>
<footer class="site-footer"><span>{siteConfig.title}<small>每一次阅读，都是一次重新思考。</small></span><span><a href={siteConfig.github}>GitHub ↗</a><small>© {new Date().getFullYear()} {siteConfig.author}</small></span></footer>
<script>
  const button = document.querySelector<HTMLButtonElement>('#theme-toggle');
  function isDark() { return document.documentElement.dataset.theme ? document.documentElement.dataset.theme === 'dark' : matchMedia('(prefers-color-scheme: dark)').matches; }
  function label() { button?.setAttribute('aria-label', isDark() ? '切换至明亮主题' : '切换至深色主题'); }
  label();
  button?.addEventListener('click', () => { const theme = isDark() ? 'light' : 'dark'; document.documentElement.dataset.theme = theme; try { localStorage.setItem('theme', theme); } catch {} label(); });
</script>
</body>
</html>
